# Mẫu file môi trường production (ENV_FILE). Copy thành env.production, điền giá trị,
# KHÔNG commit file đã điền. Xem docs/deploy/huong-dan-deploy-vps.md, bước 4.
# Thay ten-mien.vn bằng tên miền thật (không có www, không có / ở cuối).

# --- Website (được nhúng vào web lúc build; đây là giá trị công khai) ---
NEXT_PUBLIC_SITE_URL=https://ten-mien.vn
NEXT_PUBLIC_BASE_URL=https://ten-mien.vn
NEXT_PUBLIC_API_URL=https://ten-mien.vn/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BANK_CODE=
NEXT_PUBLIC_BANK_ACC=
NEXT_PUBLIC_BANK_NAME=

# --- API (chỉ container API đọc; giữ bí mật) ---
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://ten-mien.vn,https://www.ten-mien.vn
FRONTEND_URL=https://ten-mien.vn
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Thanh toán SePay
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=

# Email đơn hàng (SMTP)
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Giao hàng nhanh (để false nếu chưa dùng)
GHN_ENABLED=false
GHN_ENV=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
SHIPPING_CHECKOUT_ENABLED=false
SHIPPING_FULFILLMENT_ENABLED=false
SHIPPING_JOBS_ENABLED=false

# Google Analytics 4 (tùy chọn)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Tích hợp mới: giữ tắt ở production
INTEGRATIONS_ENV=production
INTEGRATIONS_KILL_SWITCH=true
