{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "share": "ngrok http 4000",
    "ngrok-auth": "ngrok config add-authtoken",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integrations": "jest --runInBand --runTestsByPath src/integrations/integration-executor.spec.ts src/integrations/integrations.config.spec.ts src/integrations/integration.repository.spec.ts src/integrations/mock-delivery.consumer.spec.ts src/integrations/turnstile.adapter.spec.ts src/integrations/contact-protection.service.spec.ts src/mail/mail.service.spec.ts src/supabase/supabase.service.spec.ts src/orders/orders.service.spec.ts src/orders/payment-persistence.spec.ts src/orders/shipping-checkout.spec.ts src/orders/order-validation.spec.ts src/vouchers/vouchers.service.spec.ts src/users/users.security.spec.ts src/shipping/ghn/ghn.config.spec.ts && node scripts/verify-integration-permissions.cjs && node scripts/verify-integration-delivery.cjs",
    "demo:contact-protection": "node scripts/demo-contact-protection.cjs",
    "test:contact-http": "node scripts/verify-contact-http.cjs",
    "demo:analytics": "node scripts/demo-contact-protection.cjs --analytics",
    "test:analytics": "jest --runInBand --runTestsByPath src/analytics/collection-policy.service.spec.ts src/analytics/purchase-capture.service.spec.ts && node scripts/verify-purchase-capture.cjs",
    "test:purchase-http": "node scripts/verify-purchase-http.cjs",
    "test:seo": "jest --runInBand --runTestsByPath src/analytics/search-console.service.spec.ts src/analytics/search-console.controller.spec.ts",
    "test:pagespeed": "jest --runInBand --runTestsByPath src/analytics/pagespeed.service.spec.ts src/analytics/pagespeed.controller.spec.ts",
    "test:google-diagnostics": "jest --runInBand --runTestsByPath src/analytics/google-diagnostics.service.spec.ts src/analytics/google-diagnostics.controller.spec.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@googleapis/content": "^42.1.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.88.0",
    "@types/multer": "^2.0.0",
    "cache-manager": "^7.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ipaddr.js": "2.2.0",
    "nestjs-pino": "^4.5.0",
    "nodemailer": "^7.0.12",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
