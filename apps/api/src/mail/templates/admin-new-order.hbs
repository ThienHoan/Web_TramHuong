<h1>Có đơn hàng mới</h1>
<p><strong>Thời gian:</strong> {{date}}</p>
<p><strong>Mã đơn:</strong> {{id}}</p>
<p><strong>Khách hàng:</strong> {{shipping.name}} ({{shipping.phone}})</p>
<p><strong>Thanh toán:</strong> {{payment}}</p>
<p><strong>Tổng tiền:</strong> {{total}}</p>

<h3>Sản phẩm:</h3>
<ul>
    {{#each items}}
    <li>{{this.title}}{{#if this.variant_name}} ({{this.variant_name}}){{/if}} x {{this.quantity}}</li>
    {{/each}}
</ul>
