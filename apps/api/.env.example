# Application Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key

# SePay (Payment Webhook)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_ACCOUNT_NUMBER=your-bank-account-number

# GHN shipping (server only). Existing checkout is unchanged while disabled.
# Staging and production require separate GHN accounts/tokens.
GHN_ENABLED=false
GHN_ENV=staging
GHN_TOKEN=
GHN_SHOP_ID=
GHN_TIMEOUT_MS=8000
GHN_READ_RETRIES=1
# Configure x-ghn-secret as a custom header in the GHN portal (>=32 chars).
# This is a shared secret, not an assumed GHN signature standard.
GHN_WEBHOOK_SECRET=
SHIPPING_CHECKOUT_ENABLED=false
SHIPPING_FULFILLMENT_ENABLED=false
SHIPPING_JOBS_ENABLED=false

# New integration paths only. No live adapters are enabled in this batch.
# Chat uses catalog fallback; Merchant has no automatic legacy cron.
# Existing Google OAuth, GHN and image storage retain separate configuration.
INTEGRATIONS_ENV=mock
INTEGRATIONS_KILL_SWITCH=false
FEATURE_RESEND_ENABLED=false
FEATURE_GEMINI_ADVISOR_ENABLED=false
FEATURE_VECTOR_SEARCH_ENABLED=false
FEATURE_CLOUDINARY_ENABLED=false
FEATURE_GOOGLE_LOGIN_ENABLED=false
FEATURE_GA4_ENABLED=false
# Separate opt-in for durable MOCK purchase capture; no live Google transport.
FEATURE_GA4_PURCHASE_ENABLED=false
FEATURE_SEARCH_CONSOLE_SYNC_ENABLED=false
FEATURE_MERCHANT_SYNC_ENABLED=false
FEATURE_PAGESPEED_AUDIT_ENABLED=false
# Application regression warnings for mock diagnostics, not CWV pass criteria.
PAGESPEED_SCORE_DROP=10
PAGESPEED_LCP_INCREASE_MS=500
PAGESPEED_CLS_INCREASE=0.05
PAGESPEED_TBT_INCREASE_MS=200
FEATURE_TURNSTILE_ENABLED=false

# Manual Google diagnostics only. Keep OFF on localhost without Google setup.
# Requires NODE_ENV development/test + INTEGRATIONS_ENV=staging + provider flag.
# Production runtime is blocked; do not enable without approved targets/rights.
GOOGLE_DIAGNOSTICS_ENABLED=false
GOOGLE_APPROVED_PUBLIC_ORIGIN=
PAGESPEED_API_KEY=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_KEY_ID=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN_ENCRYPTED=
# One manual ADMIN/consented event to the dedicated test stream; default OFF.
FEATURE_GA4_LOCAL_BROWSER_TEST_ENABLED=false
GA4_LOCAL_TEST_ORIGIN=http://localhost:4400

# ADMIN localhost pre-purchase QA session; also requires the local browser test flag.
FEATURE_GA4_LOCAL_FUNNEL_ENABLED=false

# Internal PostgreSQL FTS; requires reviewed test-DB migration. No model/vector.
# This release only executes it in NODE_ENV development/test + INTEGRATIONS_ENV mock.
CATALOG_FTS_ENABLED=false

# Mock notification outbox: opt-in local/dev/test only, never real SMTP fallback.
# Requires delivery foundation + notifications SQL and FEATURE_RESEND_ENABLED=true.
FEATURE_NOTIFICATION_OUTBOX_ENABLED=false

# Bounded manual Merchant mock queue; requires foundation + merchant queue SQL.
# Also requires merchant mock flag and a public HTTPS origin for catalog links.
FEATURE_MERCHANT_OUTBOX_ENABLED=false
FRONTEND_URL=https://your-public-shop.example

# Durable Search Console MOCK snapshot (TEST DB only); requires foundation +
# search-console-durable-mock.sql and FEATURE_SEARCH_CONSOLE_SYNC_ENABLED=true.
FEATURE_SEARCH_CONSOLE_PERSISTENCE_ENABLED=false

# Durable PageSpeed MOCK history (TEST DB only); requires foundation +
# pagespeed-durable-mock.sql and FEATURE_PAGESPEED_AUDIT_ENABLED=true.
FEATURE_PAGESPEED_PERSISTENCE_ENABLED=false

# Admin health panel reads TEST DB mock aggregates (counts/quota/last success).
# Requires foundation + integration-ops-metrics.sql; only with INTEGRATIONS_ENV=mock.
FEATURE_INTEGRATION_OPS_METRICS_ENABLED=false

# Cloudflare Turnstile (contact form). Real siteverify runs only with
# FEATURE_TURNSTILE_ENABLED=true + INTEGRATIONS_ENV=staging + NODE_ENV development/test.
# Local: Cloudflare's documented TEST pair (always passes, not bot protection):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Real keys also need the widget hostnames (comma list, no scheme), e.g. shop.example.vn
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Gemini product selection (Interactions API). Real calls only with
# FEATURE_GEMINI_ADVISOR_ENABLED=true + INTEGRATIONS_ENV=staging + NODE_ENV development/test
# and integration-live-usage.sql installed (durable daily budget in the TEST DB).
# GEMINI_BILLING_TIER: free = Google may use prompts to improve products (test data only);
# paid = not used for training. Model allowlist: gemini-3.5-flash-lite | gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_BILLING_TIER=
GEMINI_MODEL=gemini-3.5-flash-lite
# catalog_only (default): only catalog words from the question + budget leave the server.
GEMINI_PAYLOAD_POLICY=catalog_only
GEMINI_DAILY_REQUEST_LIMIT=200
GEMINI_DAILY_TOKEN_LIMIT=300000

# Legal drafts: enable only AFTER contacts-legal-acceptance.sql on TEST DB
# and synchronized web/API deployment. Missing consent then returns 400.
LEGAL_CONSENT_ENFORCED=false

# Owner operations automation. Disabled until TEST SQL + runner are configured.
# API token: generate 32 random bytes as base64url; separate from admin/user JWTs.
# Do not put it in NEXT_PUBLIC_* or the browser. See docs/automation/README.md.
AUTOMATION_ENABLED=false
AUTOMATION_API_TOKEN=
