# Separate server-side runner environment; never import into web/build steps.
# Node >=22; pg_dump client must match or exceed the database's major version.
AUTOMATION_API_URL=http://127.0.0.1:4000/api
AUTOMATION_WEB_URL=http://127.0.0.1:3000/vi
AUTOMATION_API_TOKEN=
AUTOMATION_STATE_DIR=/var/lib/tramhuong-automation/state
# true only for Docker DNS names api/web/n8n on a private Compose network.
AUTOMATION_INTERNAL_HTTP=false

# local writes metadata-only captures; it does not send real messages.
AUTOMATION_TRANSPORT=local
AUTOMATION_WEBHOOK_ENABLED=false
AUTOMATION_WEBHOOK_URL=
# Different 32-byte base64url token, used by n8n Header Auth Authorization.
AUTOMATION_WEBHOOK_TOKEN=

AUTOMATION_BACKUP_DIR=/var/lib/tramhuong-automation/backups
