# Separate backup process environment; keep it out of the monitor/n8n process.
AUTOMATION_BACKUP_DIR=/var/lib/tramhuong-automation/backups
# 32 random bytes in base64. Keep a separate offline copy for disaster recovery.
AUTOMATION_BACKUP_KEY=
AUTOMATION_BACKUP_BUCKETS=product-images
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/tramhuong-automation/supabase-ca.crt
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only for unpack-backup: a NEW absolute directory; decrypted local files, no DB writes.
AUTOMATION_RESTORE_DIR=
